#!/usr/bin/env python3
"""Frame strips of a film's presses and releases (tools/feel/film), to Read frame by frame.

Usage: tools/feel/strips <film.mp4> <out dir> [--before N] [--after N] [--zoom F]

For each line of <film>.events it writes <out dir>/<nn>-<note>.png: the frames from N before the
press or release to N after it, at full frame rate, cropped round where the pointer was, each
labelled with its frame number, tiled six to a row.
"""

import argparse
import re
import subprocess
import sys
from pathlib import Path

COLUMNS = 6


def size_of(film: Path) -> tuple[int, int]:
    out = subprocess.run(
        [
            "ffprobe",
            "-v",
            "error",
            "-select_streams",
            "v:0",
            "-show_entries",
            "stream=width,height",
            "-of",
            "csv=p=0",
            str(film),
        ],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip()
    width, height = out.split(",")
    return int(width), int(height)


def strip(film: Path, out: Path, frame: int, at: tuple[int, int], args: argparse.Namespace) -> None:
    width, height = size_of(film)
    crop_w, crop_h = width // 2, height // 2
    x = min(max(at[0] - crop_w // 2, 0), width - crop_w)
    y = min(max(at[1] - crop_h // 2, 0), height - crop_h)
    first = max(frame - args.before, 0)
    last = frame + args.after
    count = last - first + 1
    rows = (count + COLUMNS - 1) // COLUMNS
    tile_w = int(crop_w * args.zoom)
    label = f"drawtext=text='%{{eif\\:n+{first}\\:d}}':x=8:y=8:fontsize=28:fontcolor=yellow:box=1:boxcolor=black@0.6"
    chain = (
        f"select='between(n\\,{first}\\,{last})',crop={crop_w}:{crop_h}:{x}:{y},"
        f"scale={tile_w}:-2,{label},tile={COLUMNS}x{rows}:padding=4:color=white"
    )
    subprocess.run(
        ["ffmpeg", "-loglevel", "error", "-y", "-i", str(film), "-vf", chain, "-frames:v", "1", str(out)],
        check=True,
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("film", type=Path)
    parser.add_argument("out", type=Path)
    parser.add_argument("--before", type=int, default=2)
    parser.add_argument("--after", type=int, default=21)
    parser.add_argument("--zoom", type=float, default=0.5)
    args = parser.parse_args()
    events = args.film.with_suffix(".events")
    if not events.exists():
        print(f"no events file {events}", file=sys.stderr)
        return 2
    args.out.mkdir(parents=True, exist_ok=True)
    for number, line in enumerate(events.read_text().splitlines(), start=1):
        parts = line.split(" ", 4)
        frame, kind, x, y = int(parts[0]), parts[1], int(parts[2]), int(parts[3])
        note = parts[4] if len(parts) > 4 and parts[4] else kind
        name = f"{number:02d}-" + re.sub(r"[^a-z0-9]+", "-", note.lower()).strip("-") + ".png"
        strip(args.film, args.out / name, frame, (x, y), args)
        print(args.out / name)
    return 0


if __name__ == "__main__":
    sys.exit(main())
