# Full-size art masters stay local; the folio uses the compressed copies in art/web
docs/folio/art/masters/

# Python
__pycache__/
*.pyc

# OS and editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Secrets, never commit
.env
.env.*
*.keystore
*.jks
*.p12
*.mobileprovision
export_credentials.cfg

# Research download cache
tools/research/.cache/

# Godot: import cache, and the Android build template (scripts/export_smoke.sh reinstalls it)
.godot/
/android/

# Build output: check logs, exports, screenshots
build/

# Worker comparison copies stay on disk in their own worktree
.copies/

# Per-machine Claude Code settings
.claude/settings.local.json

# Large files kept in Cloudflare R2 (tools/assets/README.md): pull them with tools/assets/assets.py
docs/archive/design-lab/**/shots/

# Frame-lab masters stay local; the lab uses JPEG copies
docs/design/art-direction/frame-lab/masters/

# Species seeds concept art (16 Nov snapshot), kept in Cloudflare R2
docs/design/art-direction/species-seeds/

# Wrangler writes the Cloudflare account into this cache folder
.wrangler/

# Reference clips live in R2 (tools/assets); only their list is in Git
docs/design/reference-clips/*.mp4

# Reference sounds live in R2 (tools/assets); only their list is in Git
docs/design/reference-sounds/**/*.wav

# Rust build output (tools/league)
tools/league/target/
