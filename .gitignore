# Full-size art masters stay local; the folio uses the compressed copies in art/web
docs/folio/art/masters/

# Python
__pycache__/
*.pyc

# OS and editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Secrets, never commit
.env
.env.*
*.keystore
*.jks
*.p12
*.mobileprovision
export_credentials.cfg

# Research download cache
tools/research/.cache/

# Godot: import cache, and the Android build template (scripts/export_smoke.sh reinstalls it)
.godot/
/android/

# Build output: check logs, exports, screenshots
build/

# Per-machine Claude Code settings
.claude/settings.local.json

# Look-and-feel phase: other studios' reference frames stay local (the manifest is committed)
docs/ideation/ui/reference/*
!docs/ideation/ui/reference/manifest.*
