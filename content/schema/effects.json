  "keywords": {
    "Acorn": "Play for gold: Acorn {acorn}, Stash {stash}, Great Hoard {great_hoard}. Three make the next size.",
    "Spill": "If a summon from this has no room, get an Acorn instead.",
    "Pass": "Gives the bonus to the last touching unit to its right, or keeps it. While recruiting, at End of Turn.",
    "Ring": "Ring a slot: whoever stands there gets the bonus.",
    "Rainbow": "A unit played into an empty slot paints it, until that unit moves or leaves.",
    "Shy": "If buffed while recruiting, it leaves and you get 2 gold next turn (4 if golden).",
    "Bristle": "An enemy that hits this in an attack takes this much back.",
    "Hunker": "Takes half damage when attacked.",
    "Hex": "Start of Combat: whoever stands across has this much less Attack.",
    "Nightshade": "When attacked, this first loses half its Health.",
    "Belly": "Holds this many units, safe inside. When this dies, they come out.",
    "Fly South": "Sells for no gold: it flies off and returns in 2 turns.",
    "Nest": "While its Bird is flying south, an Egg with half its stats fills this empty slot.",
    "Swoop": "Attacks the enemy back row while anyone is in it.",
    "Mired": "Must attack the unit that mired it.",
    "Borrowed": "Fights for the other side for one attack, then goes home.",
    "Pin": "An enemy this hurts skips its next attack.",
    "Stalled": "Skips its next attack, then loses Stalled.",
    "Mire": "Whoever stands across must attack this, even if this is in your back row.",
    "Quarry": "The enemy across becomes its quarry. This attacks it whenever it can.",
    "Bitter": "After an enemy attacks this, it loses this much Attack, down to 1.",
    "Snap": "Attacks the Mired enemy with the most Attack.",
    "Pack": "When a unit beside this attacks, this joins in, using up its own attack.",
    "Pounce": "After a unit next to this has its quarry hit, this attacks it too. Once a cycle.",
    "Egg": "Holds a Nest while its Bird is flying south: half its stats, no text."
  }
